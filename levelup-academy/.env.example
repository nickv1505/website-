# Build-time settings for the static site (copy to .env.local, then `npm run build`).
# These two values are PUBLIC by design (they ship in the website's code);
# row level security in the database protects all private data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# SECRETS DO NOT GO HERE. They live in Supabase → Edge Functions → Secrets:
#   STRIPE_SECRET_KEY      sk_test_... / sk_live_...   (create-checkout)
#   STRIPE_WEBHOOK_SECRET  whsec_...                   (stripe-webhook)
#   SITE_URL               https://your-site.netlify.app (optional, create-checkout)
#   STRIPE_PRICE_ID        price_... (optional)
#   SUPABASE_SECRET_KEY    sb_secret_... (only if the functions report a missing service key)
# For local testing, put the Stripe ones in supabase/functions/.env
