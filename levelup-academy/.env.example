# Copy to .env.local (local) or add in your hosting dashboard (production).
# Never commit real secrets.

# ---- Site -------------------------------------------------------------------
# Public URL of the site, no trailing slash. Used for Stripe and email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the contact, legal and account pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ---- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET key (sb_secret_...) or legacy service_role key. SERVER ONLY.
# Used only by the Stripe webhook and the make-admin script.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (Developers → API keys / Webhooks) -------------------------------
# Secret key: sk_test_... while testing, sk_live_... when you launch. SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Signing secret of your webhook endpoint (whsec_...). SERVER ONLY.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Optional: the ID of a one-time $49.99 USD price you created in Stripe (price_...).
# Leave empty to use the built-in $49.99 USD price.
STRIPE_PRICE_ID=
