# Copy this file to .env and fill in the values. Never commit .env.

# Your public site address (no trailing slash). Used for Stripe redirect URLs.
SITE_URL=http://localhost:3000
PORT=3000

# Stripe secret key: Dashboard -> Developers -> API keys.
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# Optional: a Price ID (price_...) from a one-time $19.99 USD product in your
# Stripe dashboard. Leave empty to use the built-in $19.99 USD price.
STRIPE_PRICE_ID=

# Shown on the Contact page, legal pages and the access page.
CONTACT_EMAIL=support@example.com

# Supplier data file (kept on the server, never public). Default: data/supplier.json
# SUPPLIER_DATA_PATH=data/supplier.json
# Or put the whole JSON in one env var instead of a file (handy on hosting platforms):
# SUPPLIER_JSON={"name":"..."}

# Lets you preview the access page with SAMPLE data at /access?demo=1.
# Ignored when NODE_ENV=production.
ALLOW_DEMO_ACCESS=true

# Set to production on your live server.
# NODE_ENV=production
